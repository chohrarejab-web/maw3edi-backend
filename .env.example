# ============================================================================
# SahaTN / Maw2idi — Production Environment Configuration
# INPDP Tunisia Compliant • Medical Data Protection Standard
# ============================================================================

NODE_ENV=production
PORT=4000

# 🌐 Official Production Origins (comma-separated for CORS & email links)
ALLOWED_ORIGIN=https://maw2idi.tn,https://www.maw2idi.tn
CLIENT_URL=https://maw2idi.tn
PUBLIC_HOST=maw2idi.tn

# 🐘 PostgreSQL Production Connection URI
# (With docker-compose.prod.yml, PGHOST=postgres & PGSSL=false are set automatically)
DATABASE_URL=postgresql://maw2idi_user:STRONG_PASSWORD_HERE@postgres:5432/sahatn
USE_POSTGRES=true
ENABLE_DEMO_SEED=false

# Database Individual Parameters
PGHOST=postgres
PGPORT=5432
PGDATABASE=sahatn
PGUSER=maw2idi_user
PGPASSWORD=STRONG_PASSWORD_HERE
PGSSL=false
PGMAX=50

# 🔐 Cryptographic Secrets (REQUIRED in prod — Generate with: openssl rand -hex 32)
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_SECRET
COOKIE_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_SECRET
ENCRYPTION_MASTER_KEY=REPLACE_WITH_64_CHAR_RANDOM_HEX_SECRET

# 📧 Production SMTP Mailer (Notifications & 2FA Codes)
GMAIL_USER=contact@sahatn.tn
GMAIL_APP_PASSWORD=REPLACE_WITH_ROTATED_APP_PASSWORD

# 📱 WhatsApp Gateway (UltraMsg)
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=
ENABLE_REAL_WHATSAPP=false

# 🔐 Google OAuth 2.0 Web Client ID
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# 🛡️ Application Security & Debugging
DEBUG_SQL=false
